rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && profile().data.active == true; }
    function company() { return profile().data.companyId; }
    function admin() { return active() && profile().data.role == 'admin'; }
    function sameCompany() { return resource.data.companyId == company(); }
    function incomingCompany() { return request.resource.data.companyId == company(); }

    match /users/{uid} {
      allow read: if active() && (uid == request.auth.uid || admin());
      allow create, update: if admin();
      allow delete: if false;
    }

    match /companies/{id} {
      allow read: if active() && id == company();
      allow write: if admin() && id == company();
    }

    match /customers/{id} {
      allow read: if active() && sameCompany();
      allow create: if active() && incomingCompany();
      allow update: if active() && sameCompany() && incomingCompany();
      allow delete: if false;
    }

    match /quotes/{id} {
      allow read: if active() && sameCompany();
      allow create: if active() && incomingCompany();
      allow update: if active() && sameCompany() && incomingCompany();
      allow delete: if false;
    }

    match /quoteFollowUps/{id} {
      allow read: if active() && sameCompany();
      allow create: if active() && incomingCompany();
      allow update: if active() && sameCompany() && incomingCompany();
      allow delete: if false;
    }

    match /reminders/{id} {
      allow read: if active() && sameCompany();
      allow create: if active() && incomingCompany()
        && request.resource.data.type == 'quote_follow_up'
        && request.resource.data.step == 1;
      allow update: if admin() && sameCompany() && incomingCompany();
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if admin() && sameCompany();
      allow create: if active() && incomingCompany() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{collection}/{id} {
      allow read: if admin() && sameCompany();
      allow create: if admin() && incomingCompany();
      allow update: if admin() && sameCompany() && incomingCompany();
      allow delete: if false;
    }
  }
}
