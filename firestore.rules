rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && profile().data.active == true && profile().data.get('deleted', false) == false; }
    function company() { return profile().data.companyId; }
    function admin() { return active() && profile().data.role == 'admin'; }
    function sameCompany() { return resource.data.companyId == company(); }
    function incomingCompany() { return request.resource.data.companyId == company(); }

    match /users/{uid} {
      allow read: if active() && (uid == request.auth.uid || (admin() && resource.data.companyId == company()));
      allow create: if admin() && request.resource.data.companyId == company();
      allow update: if admin() && resource.data.companyId == company() && request.resource.data.companyId == company();
      allow delete: if false;
    }

    match /companies/{id} {
      allow read: if active() && id == company();
      allow write: if admin() && id == company();
    }

    match /customers/{id} {
      allow read: if active() && sameCompany();
      allow create: if active() && incomingCompany();
      allow update: if active() && sameCompany() && incomingCompany();
      allow delete: if false;
    }

    match /quotes/{id} {
      allow read: if active() && sameCompany();
      allow write: if false;
    }

    match /quoteFollowUps/{id} {
      allow read: if active() && sameCompany();
      allow create: if active() && incomingCompany();
      allow update: if active() && sameCompany() && incomingCompany();
      allow delete: if false;
    }

    match /reminders/{id} {
      allow read: if active() && sameCompany();
      allow create: if (active() && incomingCompany()
        && request.resource.data.type == 'quote_follow_up'
        && request.resource.data.step == 1)
        || (admin() && incomingCompany());
      allow update: if admin() && sameCompany() && incomingCompany();
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if admin() && sameCompany();
      allow create: if active() && incomingCompany() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /checklists/{id} { allow read, write: if false; }
    match /checklistLinks/{id} { allow read, write: if false; }
    match /checklistMedia/{id} { allow read, write: if false; }
    match /vehicles/{id} {
      allow read: if active() && sameCompany() && profile().data.role in ['admin','atendente','mecanico'];
      allow create: if active() && incomingCompany() && profile().data.role in ['admin','atendente','mecanico'];
      allow update: if admin() && sameCompany() && incomingCompany();
    }
    match /serviceOrders/{id} { allow read: if active() && sameCompany() && profile().data.role in ['admin','atendente','mecanico']; }
    match /{collection}/{id} {
      allow read: if !(collection in ['checklists','checklistLinks','checklistMedia']) && admin() && sameCompany();
      allow create: if !(collection in ['quotes','checklists','checklistLinks','checklistMedia']) && admin() && incomingCompany();
      allow update: if !(collection in ['quotes','checklists','checklistLinks','checklistMedia']) && admin() && sameCompany() && incomingCompany();
      allow delete: if false;
    }
  }
}
